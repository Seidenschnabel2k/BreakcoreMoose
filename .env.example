# Copy to .env and fill in. Real environment variables override this file.

# Bot token from your Fluxer instance.
FLUXER_TOKEN=

# Your instance; the API URL is read from its /.well-known/fluxer.
FLUXER_URL=https://chat.example.com
# Or set the API base directly (skips discovery):
# FLUXER_API_URL=https://api.example.com/v1

# Music channel: the bot keeps a now-playing panel here, plays anything posted
# without the prefix, and deletes every other message. The bot needs Manage
# Messages there. One per server; separate several with commas, no spaces.
MUSIC_CHANNEL_ID=

# Starting volume in percent of the original, 0–200. Default 50. Change it
# at runtime with !volume or the web player.
VOLUME=50

# ---- Web player (optional) ----
# Where people open it, behind your reverse proxy (which must pass WebSocket
# upgrades). Leave empty to turn the web player off.
# WEB_PUBLIC_URL=https://music.example.com
# WEB_BIND=0.0.0.0:8080
# OAuth2 app registered on your Fluxer instance. Its redirect URI must be
# exactly WEB_PUBLIC_URL + /auth/callback, e.g. https://music.example.com/auth/callback
# FLUXER_OAUTH_CLIENT_ID=
# FLUXER_OAUTH_CLIENT_SECRET=
# Encrypts login cookies, at least 32 characters (e.g. `openssl rand -hex 32`).
# Without it everyone is logged out when the bot restarts.
# WEB_SECRET=

# ---- Jellyfin (optional) ----
# Adds a Jellyfin tab to the web player. Make an API key in Jellyfin's
# dashboard (Administration → API Keys).
# JELLYFIN_URL=http://jellyfin.lan:8096
# JELLYFIN_API_KEY=
# Whose library and playlists to show; default: the first administrator.
# JELLYFIN_USER=

# ---- Spotify (optional) ----
# Spotify links work without these, through Spotify's public embed page.
# With them, track and album metadata comes from the Web API (playlists and
# artists always use the embed page; the API no longer lists them for apps).
# Create an app at https://developer.spotify.com/dashboard (no redirect URI
# or login needed).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# BOT_PREFIX=!
# YTDLP_PATH=yt-dlp
# Netscape cookie file passed to yt-dlp (--cookies) to log in to YouTube.
# Default: cookies.txt in the working directory, if it exists.
# YTDLP_COOKIES=cookies.txt
# FFMPEG_PATH=ffmpeg
# MAX_TRACK_SECONDS=10800
# PLAYLIST_LIMIT=500
# RUST_LOG=info
