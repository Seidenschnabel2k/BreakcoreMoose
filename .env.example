# Copy to .env and fill in. Real environment variables override this file.

# Bot token from your Fluxer instance.
FLUXER_TOKEN=

# Your instance; the API URL is read from its /.well-known/fluxer.
FLUXER_URL=https://chat.example.com
# Or set the API base directly (skips discovery):
# FLUXER_API_URL=https://api.example.com/v1

# Music channel: the bot keeps a now-playing panel here, plays anything posted
# without the prefix, and deletes every other message. The bot needs Manage
# Messages there. One per server; separate several with commas, no spaces.
MUSIC_CHANNEL_ID=

# Playback volume in percent of the original, 0–200. Default 50.
VOLUME=50

# BOT_PREFIX=!
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# MAX_TRACK_SECONDS=10800
# PLAYLIST_LIMIT=500
# RUST_LOG=info
